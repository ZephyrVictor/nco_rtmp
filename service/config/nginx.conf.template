limit_req_zone $binary_remote_addr zone=login:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=uploads:10m;
limit_conn_zone $server_name zone=uploads_global:10m;
resolver 127.0.0.11 valid=5s ipv6=off;
upstream api_backend {
    zone api_backend 64k;
    server api:8000 resolve;
}
server {
    listen 8081;
    server_tokens off;
    location = /metrics {
        proxy_pass http://api_backend/api/metrics;
        access_log off;
    }
    location / { return 404; }
}
server {
    listen 8080;
    location / { return 308 https://$host:18443$request_uri; }
}
server {
    listen 8443 ssl;
    http2 on;
    ssl_certificate /run/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    client_max_body_size 32m;
    location = /api/auth/login {
        limit_req zone=login burst=100 nodelay;
        client_max_body_size 8k;
        proxy_pass http://api_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/ {
        proxy_pass http://api_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
    location = /_auth {
        internal;
        proxy_pass http://api_backend/internal/authorize;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_set_header Cookie $http_cookie;
    }
    location ~ ^/live/(?<stream_id>[A-Za-z0-9_-]+)\.flv$ {
        auth_request /_auth;
        proxy_pass http://srs:8080/live/$stream_id.flv?token=${PLAY_SECRET};
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_set_header Host srs;
        access_log off;
    }
    location /uploads/ {
        auth_request /_auth;
        limit_conn uploads 4;
        limit_conn uploads_global 16;
        proxy_pass http://tusd:1080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_body_timeout 120s;
    }
    location ^~ /_protected/ {
        internal;
        alias /not-mounted/;
    }
    location / { try_files $uri $uri/ /index.html; }
}
